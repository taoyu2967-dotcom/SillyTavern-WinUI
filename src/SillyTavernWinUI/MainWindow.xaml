<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SillyTavernWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:tb="using:H.NotifyIcon">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（拖拽区域） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="14"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="SillyTavern" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="SettingsButton" Grid.Column="3" VerticalAlignment="Center"
                    Padding="6,2" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="设置" Click="SettingsButton_Click">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>

        <!-- 酒馆 Web 界面 -->
        <controls:WebView2 x:Name="Browser" Grid.Row="1" />

        <!-- 启动/错误遮罩 -->
        <Grid x:Name="StartupOverlay" Grid.Row="1" Visibility="Visible"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="560">
                <ProgressRing x:Name="StartupProgress" IsActive="True" Width="44" Height="44"
                              HorizontalAlignment="Center" />
                <TextBlock x:Name="StartupStatusText" Text="正在准备酒馆…" HorizontalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock x:Name="StartupErrorText" Visibility="Collapsed" HorizontalAlignment="Center"
                           TextWrapping="Wrap" HorizontalTextAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <StackPanel x:Name="ErrorButtons" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <Button Content="打开设置" Click="OpenSettingsFromError_Click" />
                    <Button Content="重试" Style="{StaticResource AccentButtonStyle}" Click="Retry_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 系统托盘图标（事件在代码后置挂接：XAML 事件属性会触发 XamlCompiler 崩溃） -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="ms-appx:///Assets/app.ico"
                        ToolTipText="SillyTavern">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="TrayOpenItem" Text="打开酒馆" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayExitItem" Text="退出" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
